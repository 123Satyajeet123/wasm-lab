+#[cfg(feature = "svg")]
+static SUPPLIED_FONT_DB: RwLock<Option<Arc<fontdb::Database>>> = RwLock::new(None);
+
+/// Register the font faces used for SVG `<text>`.
+///
+/// SVG text is shaped through usvg's own font database, which is separate from
+/// the `parley::FontContext` in `DocumentConfig`. Without this, that database
+/// is populated only by `load_system_fonts()`, so SVG text renders blank in any
+/// environment that has none — notably WASM.
+#[cfg(feature = "svg")]
+pub fn register_svg_fonts(faces: &[&[u8]]) {
+    let mut db = fontdb::Database::new();
+    for face in faces {
+        db.load_font_data(face.to_vec());
+    }
+    let family = db.faces().next().map(|face| face.families[0].0.clone());
+    if let Some(name) = family {
+        db.set_sans_serif_family(name.clone());
+        db.set_serif_family(name.clone());
+        db.set_monospace_family(name.clone());
+        db.set_cursive_family(name.clone());
+        db.set_fantasy_family(name);
+    }
+    *SUPPLIED_FONT_DB.write().unwrap() = Some(Arc::new(db));
+}
+
+#[cfg(feature = "svg")]
+pub(crate) fn svg_font_db() -> Arc<fontdb::Database> {
+    if let Some(db) = SUPPLIED_FONT_DB.read().unwrap().as_ref() {
+        return Arc::clone(db);
+    }
+    Arc::clone(&SYSTEM_FONT_DB)
+}
